  "scripts": {
    "dev:api": "nx serve api",
    "dev:admin": "nx serve admin",
    "dev:user": "nx serve user",
    "dev": "concurrently -n api,admin,user -c blue,green,magenta \"npm run dev:api\" \"npm run dev:admin\" \"npm run dev:user\"",
    "build:api": "nx build api",
    "build:admin": "nx build admin",
    "build:user": "nx build user",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "ts-node --compiler-options {\"module\":\"commonjs\"} prisma/seed.ts",
    "db:studio": "prisma studio --schema=prisma/schema.prisma"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"commonjs\"} prisma/seed.ts"
  },
  "private": true,
