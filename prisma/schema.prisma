generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum SocialPlatform {
  LINKEDIN
  FACEBOOK
  X
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  PARTIAL
}

enum PublishStatus {
  PENDING
  SUCCESS
  FAILED
}

// What kind of destination a connected account posts to. Not every platform
// supports every type — see each publisher service for what's actually wired up.
enum DestinationType {
  PERSONAL
  PAGE
  GROUP
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(USER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdByAdminId String?
  createdByAdmin    User?   @relation("AdminCreatedUsers", fields: [createdByAdminId], references: [id])
  createdUsers      User[]  @relation("AdminCreatedUsers")

  subscription  Subscription?
  socialAccounts SocialAccount[]
  posts         Post[]

  @@map("users")
}

// A plan template admins can assign to users. The four defaults (Free/Creator/
// Professional/Agency) are seeded rows, not hardcoded — admins can disable any
// of them (isActive=false stops new assignments; existing subscribers keep
// working) or create their own custom plan with its own limits and price.
model Plan {
  id                     String   @id @default(uuid())
  name                   String   @unique
  price                  Int      @default(0)
  // null = unlimited
  postsLimit             Int?
  connectedAccountsLimit Int?
  // Which platforms a subscriber on this plan may connect at all (separate from
  // connectedAccountsLimit, which caps how many total). Defaults to all three.
  platforms              SocialPlatform[] @default([LINKEDIN, FACEBOOK, X])
  isCustom               Boolean  @default(false)
  isActive               Boolean  @default(true)
  // Stripe recurring Price ID (price_...) this plan checks out against. Required
  // for any plan with price > 0 before someone can actually sign up for it — null
  // is fine (and expected) for the Free plan, which never touches Stripe at all.
  stripePriceId          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan               @relation(fields: [planId], references: [id])
  status        SubscriptionStatus @default(ACTIVE)
  // Set once the user has checked out for a paid plan; both stay null for
  // everyone on a free plan and for accounts an admin granted access to directly.
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  startDate     DateTime           @default(now())
  endDate       DateTime?
  grantedByAdminId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("subscriptions")
}

// One row per connected destination. A user can have more than one per platform
// now (e.g. a Facebook Page AND a Facebook Group, or a LinkedIn personal profile
// AND a LinkedIn Company Page) — uniqueness is per actual destination, not per platform.
model SocialAccount {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          SocialPlatform
  destinationType   DestinationType @default(PERSONAL)
  platformUserId    String
  platformUsername  String?
  accessToken       String
  refreshToken      String?
  tokenExpiresAt    DateTime?
  scopes            String?
  connectedAt       DateTime        @default(now())
  metadata          Json?

  results PostPublishResult[]

  @@unique([userId, platform, platformUserId])
  @@map("social_accounts")
}

model Post {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         String
  imageUrl        String?
  // The specific connected destinations (SocialAccount ids) this post targets —
  // lets a post go to e.g. one Facebook Page but not another, or a Facebook Page
  // and a Facebook Group at once.
  destinationIds  String[]
  // Denormalized set of platforms represented in destinationIds, kept for quick
  // filtering/display without joining against SocialAccount.
  platforms       SocialPlatform[]
  // Per-platform overrides of `content` (e.g. a shortened version for X's 280-char
  // limit) produced by the rule-based auto-adapt step. Keyed by SocialPlatform;
  // a platform without an entry here just publishes `content` as-is.
  platformContent Json?
  status          PostStatus   @default(DRAFT)
  scheduledAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  results     PostPublishResult[]

  @@map("posts")
}

model PostPublishResult {
  id              String         @id @default(uuid())
  postId          String
  post            Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Nullable: historical rows from before multi-destination support, or a
  // destination the user has since disconnected, won't have a live account to point to.
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  platform        SocialPlatform
  // Denormalized "Page/Group/Personal" label captured at publish time, so the
  // post history still reads sensibly even if the account is later disconnected.
  destinationLabel String?
  status          PublishStatus  @default(PENDING)
  platformPostId  String?
  error           String?
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())

  @@unique([postId, socialAccountId])
  @@map("post_publish_results")
}
