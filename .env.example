# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncpost?schema=public"
# Only needed separately when DATABASE_URL goes through a connection pooler
# (e.g. Supabase's transaction pooler on port 6543) — migrations need a direct
# connection. Same value as DATABASE_URL is fine for local Postgres.
#
# Supabase example:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/syncpost?schema=public"

# ---- Auth ----
# Must be at least 32 characters. The API refuses to start if this is
# missing, too short, or left as this placeholder — it previously fell back
# to a hardcoded string, which meant anyone could forge an admin token.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=""

# Encrypts stored OAuth access/refresh tokens at rest (AES-256-GCM). Must be
# at least 32 characters and different from JWT_SECRET. Changing it makes every
# already-stored token undecryptable, forcing all users to reconnect.
# Generate one with:  openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=""

# ---- First admin account (used by `npm run db:seed`) ----
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
ADMIN_NAME="SyncPost Admin"

# ---- App URLs (used for CORS + OAuth redirect-after-connect) ----
API_URL="http://localhost:3000/api"
USER_APP_URL="http://localhost:4200"
ADMIN_APP_URL="http://localhost:4201"
PORT=3000

# ---- Image uploads (cloudinary.com -> free account -> Dashboard shows these three) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- LinkedIn (developers.linkedin.com -> create app -> add "Sign In with LinkedIn
#      using OpenID Connect" + "Share on LinkedIn" products) ----
# Add BOTH redirect URIs below to the app's "Authorized redirect URLs".
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/social/LINKEDIN/callback"
LINKEDIN_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/oauth/LINKEDIN/callback"
# Off by default. r_organization_admin / w_organization_social require LinkedIn's
# Marketing Developer Platform partner approval — a formal application review, not
# something you get by just adding testers. Requesting these before that approval
# will make the whole LinkedIn login grant fail. Flip on only once LinkedIn has
# actually approved these scopes for your app.
LINKEDIN_ENABLE_ORGANIZATIONS="false"

# ---- Facebook / Meta (developers.facebook.com -> create app -> add "Facebook Login") ----
# Add BOTH redirect URIs below to "Valid OAuth Redirect URIs" in the Facebook Login settings.
# Signing in with Facebook also requests pages_manage_posts to auto-connect a Page for
# publishing; outside your app's own admins/testers, that scope needs Meta App Review
# before it works for other users.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/social/FACEBOOK/callback"
FACEBOOK_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/oauth/FACEBOOK/callback"
# Off by default. publish_to_groups is a restricted Meta permission rarely granted to
# third-party apps, and each target Group's own admins must additionally add this app
# under the Group's Settings > Apps. Only flip on after confirming pages_* already
# works AND publish_to_groups shows as usable in your app's Permissions and Features —
# requesting it before you actually have access can break Facebook login entirely.
FACEBOOK_ENABLE_GROUPS="false"

# ---- X / Twitter (developer.x.com -> create app -> enable OAuth 2.0) ----
# Add BOTH redirect URIs below to the app's "Callback URI / Redirect URL" list.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/social/X/callback"
X_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/oauth/X/callback"

# ---- Stripe (dashboard.stripe.com -> Developers -> API keys) ----
# Use test-mode keys (sk_test_...) while developing. Create a Product + recurring
# Price for each paid plan in the dashboard, then paste the Price ID (price_...)
# into that plan's "Stripe price ID" field in the admin Plans page.
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally, or
# the signing secret shown for the endpoint you register in the dashboard for prod.
STRIPE_WEBHOOK_SECRET=""

# ---- Google (console.cloud.google.com/apis/credentials -> Create OAuth client ID
#      -> Web application) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/oauth/google/callback"
