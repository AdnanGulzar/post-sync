# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncpost?schema=public"

# ---- Auth ----
JWT_SECRET="replace-with-a-long-random-string"

# ---- First admin account (used by `npm run db:seed`) ----
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
ADMIN_NAME="SyncPost Admin"

# ---- App URLs (used for CORS + OAuth redirect-after-connect) ----
API_URL="http://localhost:3000/api"
USER_APP_URL="http://localhost:4200"
ADMIN_APP_URL="http://localhost:4201"
PORT=3000

# ---- LinkedIn (developers.linkedin.com -> create app -> add "Sign In with LinkedIn
#      using OpenID Connect" + "Share on LinkedIn" products) ----
# Add BOTH redirect URIs below to the app's "Authorized redirect URLs".
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/social/LINKEDIN/callback"
LINKEDIN_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/oauth/LINKEDIN/callback"

# ---- Facebook / Meta (developers.facebook.com -> create app -> add "Facebook Login") ----
# Add BOTH redirect URIs below to "Valid OAuth Redirect URIs" in the Facebook Login settings.
# Signing in with Facebook also requests pages_manage_posts to auto-connect a Page for
# publishing; outside your app's own admins/testers, that scope needs Meta App Review
# before it works for other users.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/social/FACEBOOK/callback"
FACEBOOK_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/oauth/FACEBOOK/callback"

# ---- X / Twitter (developer.x.com -> create app -> enable OAuth 2.0) ----
# Add BOTH redirect URIs below to the app's "Callback URI / Redirect URL" list.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/social/X/callback"
X_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/oauth/X/callback"
